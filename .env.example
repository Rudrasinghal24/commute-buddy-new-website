# GEMINI_API_KEY: Required for Gemini AI Trip Assistant & live transit/fare verification.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# MAPBOX_ACCESS_TOKEN: Optional Mapbox Streets v12 high-DPI map tiles (falls back to CARTO Voyager / OpenStreetMap).
MAPBOX_ACCESS_TOKEN=""

# GOOGLE_ROUTES_API_KEY: Optional Google Routes API v2 key for live traffic-aware road & transit directions.
GOOGLE_ROUTES_API_KEY=""

# ORS_API_KEY: Optional OpenRouteService API key for road, bike, and walking directions & polylines.
ORS_API_KEY=""

# TOMTOM_API_KEY: Optional TomTom Traffic Flow Segment API key for real-time road congestion multipliers.
TOMTOM_API_KEY=""

# HERE_API_KEY: Optional HERE Maps API key for fallback traffic & transit routing.
HERE_API_KEY=""

# OTD_DELHI_API_KEY: Optional Open Transit Data Delhi API key for live DTC/Cluster bus GTFS-RT feeds.
OTD_DELHI_API_KEY=""

# TRAIN_PRIMARY_API_KEY: Optional primary Indian Railways live train status & schedule API key.
TRAIN_PRIMARY_API_KEY=""

# TRAIN_SECONDARY_API_KEY: Optional secondary fallback Indian Railways API key.
TRAIN_SECONDARY_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
